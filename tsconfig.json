{
  "compilerOptions": {
    /* Core */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    /* Paths */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Frontend */
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* Backend support */
    "types": ["node", "vitest/globals"],
    "resolveJsonModule": true,

    /* Emit — Vite handles bundling; tsc is type-check only */
    "noEmit": true,

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,

    /* Relaxed rules */
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,

    /* Misc */
    "allowJs": true
  },

  "include": ["src", "backend/**/*.ts", "backend/utils/loadRoutes.js"],

  "exclude": ["node_modules", "backend/dist"]
}