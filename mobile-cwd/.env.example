# Expo inlines EXPO_PUBLIC_* vars at build/bundle time — no extra package needed.
#
# IN DEV YOU CAN USUALLY LEAVE THIS UNSET: src/utils/apiBase.ts auto-detects
# the machine running `npm start` from the Metro bundler URL and assumes the
# backend is on :5000 there — so a phone on the same Wi‑Fi just works.
#
# Set it explicitly when the auto-detection is wrong or for real builds:
#
# Physical device, backend on a non-default host/port:
#   EXPO_PUBLIC_API_URL=http://192.168.0.42:5000
#
# Android emulator, backend on the host machine (auto-detect also handles this):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#
# Staging / production:
#   EXPO_PUBLIC_API_URL=https://civiliererp.in
#
# EXPO_PUBLIC_API_URL=
