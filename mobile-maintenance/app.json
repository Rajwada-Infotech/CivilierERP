{
  "expo": {
    "name": "Civilier Home",
    "slug": "mobile-maintenance",
    "scheme": "civiliererpmaintenance",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rajwadainfotech.civiliermaintenance",
      "infoPlist": {
        "NSCameraUsageDescription": "Civilier Home uses the camera to attach photos to your documents and maintenance records.",
        "NSPhotoLibraryUsageDescription": "Civilier Home needs access to your photo library to attach existing photos to your documents and records."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9F5E1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rajwadainfotech.civiliermaintenance",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Civilier Home uses the camera so you can photograph or scan papers to upload."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "owner": "grenxnja",
    "extra": {
      "eas": {
        "projectId": "51603a89-ed81-4116-95b3-19d38236c7a0"
      }
    }
  }
}
