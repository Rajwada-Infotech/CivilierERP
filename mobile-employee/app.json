{
  "expo": {
    "name": "Employee Portal App",
    "slug": "mobile-employee",
    "scheme": "civilieremployee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rajwadainfotech.civilieremployee",
      "infoPlist": {
        "NSCameraUsageDescription": "Employee Portal App takes a live photo when you punch In and Out, as attendance evidence.",
        "NSLocationWhenInUseUsageDescription": "Employee Portal App records your location when you punch In and Out, as attendance evidence."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rajwadainfotech.civilieremployee",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Employee Portal App records your location when you punch In and Out, as attendance evidence."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Employee Portal App takes a live photo when you punch In and Out, as attendance evidence."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Employee Portal App uses the front camera for your face registration and the live photo when you punch In and Out.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a2bf5359-10fe-4be8-a43f-8d1064652aee"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a2bf5359-10fe-4be8-a43f-8d1064652aee"
    }
  }
}
