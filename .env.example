# Copy this file for local development only:
#   cp backend/.env.example backend/.env
#
# In production, keep secrets outside the repo and point Docker Compose at them:
#   CIVILIER_ENV_FILE=/etc/civilier/prod.env docker compose up -d

NODE_ENV=development
PORT=5000

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CivilierERP
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# For AWS RDS SQL Server, use:
#   DB_ENCRYPT=true
#   DB_TRUST_SERVER_CERTIFICATE=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Generate with:
#   openssl rand -hex 64
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# Comma-separated browser origins allowed by CORS and socket.io.
# Production example:
#   ALLOWED_ORIGINS=https://civiliererp.in,https://www.civiliererp.in
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Required for /health/ready and /health/startup.
# Generate with:
#   openssl rand -hex 32
HEALTH_TOKEN=CHANGE_ME
