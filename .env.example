# Database (SQL Server) - EDIT THESE!
DB_USER=sa
DB_PASSWORD=yourpassword
DB_SERVER=localhost,1433
DB_NAME=CivilierERP
# Used by docker-compose to set the SQL Server SA password (must match DB_PASSWORD)
LOCAL_SA_PASSWORD=yourpassword

# Redis
# docker-compose reads REDIS_PASSWORD from backend/.env.
# Set REDIS_HOST=redis for container deployment; use 127.0.0.1 for local backend.
# REDIS_HOST=redis
# REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_long_random_secret

# App
NODE_ENV=production
PORT=5000

# JWT etc (keep your existing)
JWT_SECRET=your_jwt_secret_here

