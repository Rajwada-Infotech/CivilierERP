import React from "react"
import { Breadcrumbs } from "@/components/Breadcrumbs"
import { MasterPage, type DataChangeEvent } from "@/components/MasterPage"
import { useQuery, useQueryClient } from "@tanstack/react-query"
import { getEnterprises, addEnterprise, updateEnterprise, deleteEnterprise } from "@/api/enterpriseApi"
import { toast } from "sonner"

const fields = [
  { name: "name", label: "Contractor Name", type: "text", required: true },
  { name: "contact", label: "Contact Person", type: "text" },
  { name: "phone", label: "Phone Number", type: "text" },
  { name: "email", label: "Email Address", type: "text" },
  { name: "gst", label: "GST Number", type: "text", uppercase: true },
  { name: "pan", label: "PAN Number", type: "text", uppercase: true },
  { name: "type", label: "Contractor Type", type: "select", options: ["Civil", "Electrical", "Mechanical", "Plumbing", "General"] },
  { name: "paymentTerms", label: "Payment Terms", type: "select", options: ["Advance", "15 Days", "30 Days", "45 Days", "60 Days"] },
  { name: "address", label: "Address", type: "textarea", fullWidth: true },
  { name: "status", label: "Status", type: "toggle", defaultValue: true },
];

const columns = [
  { key: "name", label: "Contractor Name" },
  { key: "contact", label: "Contact Person" },
  { key: "phone", label: "Phone" },
  { key: "gst", label: "GST No." },
  { key: "type", label: "Type" },
  { key: "paymentTerms", label: "Payment Terms" },
  { key: "status", label: "Status" },
];

const toPayload = (r: Record<string, unknown>) => ({
  name: r.name as string,
  business_type: (r.type as string) || "Contractor",
  pan: (r.pan as string) || null,
  address: (r.address as string) || null,
  email: (r.email as string) || null,
  phone_number: (r.phone as string) || null,
  status: r.status === true ? "Active" : "Inactive",
  description: `Contractor: ${r.contact || ""}, GST: ${r.gst || ""}, Terms: ${r.paymentTerms || ""}`,
  // other fields null
});

const ContractorMaster = () => {
  const queryClient = useQueryClient()

  const { data: dbData, isLoading, error } = useQuery({
    queryKey: ["contractors"],
    queryFn: getEnterprises,
  })

  const dbItems = Array.isArray(dbData) ? dbData : []

  // Filter/map for contractors (e.g. business_type Company/Firm or name has Builders)
  const contractorData = dbItems
    .filter(item => 
      (item.business_type?.toLowerCase().includes("firm") || 
       item.business_type?.toLowerCase().includes("company") ||
       item.name?.toLowerCase().includes("builder") ||
       item.name?.toLowerCase().includes("construct"))
    )
    .map(item => ({
      _id: String(item.id),
      name: item.name || "",
      contact: item.contact || "",
      phone: item.phone_number || "",
      email: item.email || "",
      gst: item.gst || "",
      pan: item.pan || "",
      type: item.business_type || "General",
      paymentTerms: item.payment_terms || "30 Days",
      address: item.address || "",
      status: item.status !== "Inactive",
    }))

  const handleDataEvent = async (event: DataChangeEvent) => {
    try {
      if (event.action === "add") {
        await addEnterprise(toPayload(event.record))
        toast.success("Contractor saved!")
      } else if (event.action === "update") {
        await updateEnterprise(event.id, toPayload(event.record))
        toast.success("Contractor updated!")
      } else if (event.action === "delete") {
        await deleteEnterprise(event.id)
        toast.success("Contractor deleted!")
      }
      await queryClient.invalidateQueries({ queryKey: ["contractors", "enterprises"] })
    } catch (err: any) {
      toast.error(err.message || "Operation failed")
    }
  }

  if (isLoading) return <div className="p-6 text-muted-foreground">Loading contractors...</div>
  if (error) return <div className="p-6 text-destructive">Failed to load contractors.</div>

  return (
    <>
      <Breadcrumbs items={["Dashboard", "Finance Module", "Contractor Master"]} />
      <h1 className="text-xl font-heading font-bold text-foreground mb-4">Contractor Master</h1>
      <MasterPage 
        title="Contractor" 
        fields={fields} 
        columns={columns} 
        initialData={contractorData}
        onDataEvent={handleDataEvent}
      />
    </>
  )
}

export default ContractorMaster

