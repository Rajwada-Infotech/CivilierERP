# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (SQL Server) ─────────────────────────────────────────────────────
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CivilierERP
DB_USER=sa
DB_PASSWORD=your_password_here
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── CORS (comma-separated list of allowed origins) ───────────────────────────
# Defaults are set in server.js; add production domain here if needed
ALLOWED_ORIGIN=https://civiliererp.in
