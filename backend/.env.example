# Copy this file for local development only:
#   cp backend/.env.example backend/.env
#
# In production, keep secrets outside the repo and point Docker Compose at them:
#   CIVILIER_ENV_FILE=/etc/civilier/prod.env docker compose up -d

NODE_ENV=development
PORT=5001

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# For AWS RDS SQL Server, use:
#   DB_ENCRYPT=true
#   DB_TRUST_SERVER_CERTIFICATE=false
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Generate with:
#   openssl rand -hex 64
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# Comma-separated browser origins allowed by CORS and socket.io.
# Production example:
#   ALLOWED_ORIGINS=https://civiliererp.in,https://www.civiliererp.in
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Required for /health/ready and /health/startup.
# Generate with:
#   openssl rand -hex 32
HEALTH_TOKEN=CHANGE_ME

# Proxies in front of the backend: 1 = nginx only (today). Set 2 when an AWS load balancer sits in front of nginx,
# so the activity log and rate limits see the visitor's real address.
TRUST_PROXY_HOPS=1

# ── Attendance face verification + geofence (migration 692) ────────────────────
# AES-256-GCM key for face templates — 32 random bytes, base64. Keep it OUT of the database and out of git.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes every registered face unusable (re-register in Employee Master).
FACE_TEMPLATE_KEY=
FACE_TEMPLATE_KEY_ID=env-1
# Cosine similarity needed for a match (SFace / MobileFaceNet; OpenCV's reference is 0.363).
FACE_MATCH_THRESHOLD=0.40
# Failed face checks allowed in FACE_LOCK_MINUTES before punches are refused for that long.
FACE_MAX_FAILS=5
FACE_LOCK_MINUTES=15
# GPS accuracy needed for a punch (metres).
ATTENDANCE_GPS_MAX_ACCURACY_M=100
# Set to false to switch a check off for this deployment.
ATTENDANCE_FACE_REQUIRED=true
ATTENDANCE_GEOFENCE_REQUIRED=true
