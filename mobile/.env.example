# Expo inlines EXPO_PUBLIC_* vars at build/bundle time — no extra package
# needed. Copy this to .env and point it at your backend.
#
# Physical device on the same LAN as your dev machine: use your machine's
# LAN IP, not localhost (the phone can't resolve your PC's localhost).
#   EXPO_PUBLIC_API_URL=http://192.168.0.42:5000
#
# Android emulator talking to a backend running on the host machine:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
EXPO_PUBLIC_API_URL=http://localhost:5000
